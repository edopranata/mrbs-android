<resources>
    <!-- Tampilan dibuat dengan Jetpack Compose; tema XML ini hanya untuk jendela aktivitas. -->
    <style name="Theme.MRBS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <!-- Splash screen saat aplikasi dibuka (memeriksa sesi login). -->
    <style name="Theme.MRBS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MRBS</item>
    </style>
</resources>
